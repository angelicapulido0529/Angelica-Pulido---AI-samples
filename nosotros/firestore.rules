rules_version = '2';

// Reglas de seguridad de "Nosotros" (plan gratis de Firebase).
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
//
// - Solo las dos personas de la pareja pueden ver sus stories.
// - Una pareja tiene como máximo dos personas.
// - Cada quien tiene un solo documento de story: una nueva reemplaza la anterior.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function coupleAfter(id) {
      return getAfter(/databases/$(database)/documents/couples/$(id)).data;
    }
    function isMember(coupleId) {
      return signedIn() &&
        me() in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }
    function myCouple() {
      return get(/databases/$(database)/documents/users/$(me())).data.get('coupleId', null);
    }
    function validName(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 20;
    }
    function validPhoto(d) {
      return !('photo' in d) || (d.photo is bytes && d.photo.size() < 200 * 1024);
    }

    // ---- Perfiles ----
    match /users/{uid} {
      allow read: if signedIn() && (uid == me() ||
        (myCouple() != null && resource.data.get('coupleId', null) == myCouple()));

      allow create: if signedIn() && uid == me() &&
        request.resource.data.keys().hasOnly(['name', 'photo', 'createdAt']) &&
        validName(request.resource.data) && validPhoto(request.resource.data);

      allow update: if signedIn() && uid == me() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photo', 'coupleId']) &&
        validName(request.resource.data) && validPhoto(request.resource.data) &&
        // Solo puedes unirte a una pareja de la que ya eres miembro
        // (en la misma operación), y no puedes cambiarte de pareja.
        (!('coupleId' in request.resource.data.diff(resource.data).affectedKeys()) ||
         (resource.data.get('coupleId', null) == null &&
          me() in coupleAfter(request.resource.data.coupleId).members) ||
         // Cambiar un código propio sin usar por el de tu pareja.
         (resource.data.get('coupleId', null) != null &&
          get(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.members == [me()] &&
          me() in coupleAfter(request.resource.data.coupleId).members));
    }

    // ---- Parejas ----
    match /couples/{coupleId} {
      allow read: if isMember(coupleId);

      // Crear una pareja donde solo estás tú (esperando a tu pareja).
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['members', 'code', 'createdAt']) &&
        request.resource.data.members == [me()] &&
        request.resource.data.code is string &&
        getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code))
          .data.coupleId == coupleId;

      // Unirse: solo si hay exactamente una persona y te agregas tú.
      allow update: if signedIn() &&
        resource.data.members.size() == 1 &&
        !(me() in resource.data.members) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members == resource.data.members.concat([me()]) &&
        // En la misma operación se borra el código (ya no sirve).
        !existsAfter(/databases/$(database)/documents/codes/$(resource.data.code));
    }

    // ---- Códigos para vincularse ----
    match /codes/{code} {
      // Hay que saber el código exacto; no se pueden listar.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['coupleId']) &&
        coupleAfter(request.resource.data.coupleId).members == [me()];
      allow delete: if signedIn() &&
        me() in coupleAfter(resource.data.coupleId).members;
    }

    // ---- Stories (una por persona; id = su uid) ----
    match /couples/{coupleId}/stories/{ownerUid} {
      allow read: if isMember(coupleId);

      // Subir o reemplazar tu propia story.
      allow create, update: if isMember(coupleId) && ownerUid == me() &&
        request.resource.data.keys().hasOnly(
          ['storyId', 'image', 'message', 'createdAt', 'expiresAt', 'likedAt', 'likedBy']) &&
        request.resource.data.storyId is string &&
        request.resource.data.image is bytes &&
        request.resource.data.image.size() < 1000 * 1024 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 120 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(25, 'h') &&
        request.resource.data.likedAt == null &&
        request.resource.data.likedBy == null;

      // Tu pareja solo puede dar o quitar like.
      allow update: if isMember(coupleId) && ownerUid != me() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedAt', 'likedBy']) &&
        ((request.resource.data.likedAt == request.time &&
          request.resource.data.likedBy == me()) ||
         (request.resource.data.likedAt == null &&
          request.resource.data.likedBy == null));

      // Borrar: la dueña cuando quiera; cualquiera de los dos si ya venció.
      allow delete: if isMember(coupleId) &&
        (ownerUid == me() || resource.data.expiresAt < request.time);
    }
  }
}
